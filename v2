import requests
import csv
import os
from datetime import datetime, timedelta
from collections import defaultdict

# Liste des stations : nom, latitude, longitude, apiKey (WU), units, source_nws (True/False)
# source_nws = True uniquement pour les stations US (weather.gov ne couvre que les US)
stations = [
    ("New York", 40.761, -73.864, "e1f10a1e78da46f5b10a1e78da96f525", "e", True),
    ("Miami", 25.848, -80.242, "e1f10a1e78da46f5b10a1e78da96f525", "e", True),
]

# La NWS (weather.gov) exige un User-Agent identifiable (nom d'app + contact)
NWS_HEADERS = {
    "User-Agent": "(temperatures-3jours-script, contact@example.com)",
    "Accept": "application/geo+json",
}

today = (datetime.now() + timedelta(hours=2)).date()

# Liste qui contiendra les résultats pour le CSV
results = []


def fetch_wu_temps_by_day(lat, lon, api_key, units):
    """Récupère les températures horaires WU et les regroupe par jour."""
    url = (
        "https://api.weather.com/v3/wx/forecast/hourly/15day"
        f"?apiKey={api_key}"
        f"&geocode={lat},{lon}"
        f"&units={units}&language=en-US&format=json"
    )
    response = requests.get(url, timeout=10)
    response.raise_for_status()
    data = response.json()

    times = data["validTimeLocal"]
    temperatures = data["temperature"]

    temps_by_day = defaultdict(list)
    for time_str, temp in zip(times, temperatures):
        dt = datetime.fromisoformat(time_str)
        day = dt.date()
        if today <= day <= today + timedelta(days=2):
            temps_by_day[day].append(temp)

    return temps_by_day


def fetch_nws_temps_by_day(lat, lon):
    """Récupère les prévisions horaires NWS (weather.gov) et les regroupe par jour."""
    # Étape 1 : résoudre les coordonnées en URL de prévision horaire
    points_url = f"https://api.weather.gov/points/{lat},{lon}"
    points_resp = requests.get(points_url, headers=NWS_HEADERS, timeout=10)
    points_resp.raise_for_status()
    forecast_hourly_url = points_resp.json()["properties"]["forecastHourly"]

    # Étape 2 : récupérer la prévision horaire elle-même
    forecast_resp = requests.get(forecast_hourly_url, headers=NWS_HEADERS, timeout=10)
    forecast_resp.raise_for_status()
    periods = forecast_resp.json()["properties"]["periods"]

    temps_by_day = defaultdict(list)
    for period in periods:
        # startTime est déjà en heure locale de la station, avec offset (ex: -05:00)
        dt = datetime.fromisoformat(period["startTime"])
        day = dt.date()
        if today <= day <= today + timedelta(days=2):
            temps_by_day[day].append(period["temperature"])

    return temps_by_day


def add_results(station_name, source_label, temps_by_day, request_time):
    """Calcule Tmin/Tmax par jour et alimente la liste `results` + affichage console."""
    print(f"\n=== {station_name} ({source_label}) ===")
    for offset in range(3):
        day = today + timedelta(days=offset)
        if day in temps_by_day:
            tmin = min(temps_by_day[day])
            tmax = max(temps_by_day[day])
            print(f"J+{offset} ({day}) : Tmin = {tmin}°C | Tmax = {tmax}°C")
            results.append({
                "Station": station_name,
                "Source": source_label,
                "Heure_requete": request_time.strftime("%Y-%m-%d %H:%M:%S"),
                "Jour": f"J+{offset}",
                "Date": day.isoformat(),
                "Tmin": tmin,
                "Tmax": tmax,
            })
        else:
            print(f"J+{offset} ({day}) : aucune donnée disponible")


for station_name, lat, lon, api_key, units, source_nws in stations:

    request_time = datetime.now() + timedelta(hours=2)

    # --- Source 1 : Weather Underground (comme actuellement) ---
    try:
        wu_temps_by_day = fetch_wu_temps_by_day(lat, lon, api_key, units)
        add_results(station_name, "WU", wu_temps_by_day, request_time)
    except requests.RequestException as e:
        print(f"\n=== {station_name} (WU) ===")
        print(f"Erreur lors de l'appel API WU : {e}")

    # --- Source 2 : weather.gov (uniquement pour les stations US) ---
    if source_nws:
        try:
            nws_temps_by_day = fetch_nws_temps_by_day(lat, lon)
            add_results(station_name, "NWS", nws_temps_by_day, request_time)
        except requests.RequestException as e:
            print(f"\n=== {station_name} (NWS) ===")
            print(f"Erreur lors de l'appel API weather.gov : {e}")

# Enregistrement dans un fichier CSV (ajout sans écraser)
csv_file = "temperatures_3jours.csv"
file_exists = os.path.isfile(csv_file)

with open(csv_file, mode="a", newline="", encoding="utf-8") as file:
    writer = csv.DictWriter(
        file,
        fieldnames=[
            "Station",
            "Source",
            "Heure_requete",
            "Jour",
            "Date",
            "Tmin",
            "Tmax",
        ]
    )
    if not file_exists:
        writer.writeheader()
    writer.writerows(results)

print(f"\nLes résultats ont été ajoutés dans : {csv_file}")
